{
  "name": "script-inspector",
  "version": "0.1.0",
  "description": "Inspect package.json scripts for common Node.js setup issues without running them.",
  "author": "Azmol Wasim Hussain",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azmolwasimhussain-ops/script-inspector.git"
  },
  "bugs": {
    "url": "https://github.com/azmolwasimhussain-ops/script-inspector/issues"
  },
  "homepage": "https://github.com/azmolwasimhussain-ops/script-inspector#readme",
  "type": "commonjs",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "require": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "bin": {
    "script-inspector": "bin/script-inspector.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "npm",
    "package-json",
    "scripts",
    "cli",
    "developer-tools",
    "static-analysis",
    "nodejs"
  ],
  "scripts": {
    "test": "node --test"
  }
}
